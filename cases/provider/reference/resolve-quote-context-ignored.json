{
  "name": "resolve by quote ignores prefix, suffix and pos",
  "fixture": "notes.json",
  "steps": [
    {
      "send": {
        "method": "hello",
        "params": {
          "protocol": [
            1
          ],
          "client": {
            "name": "conformance",
            "version": "0"
          },
          "root": "."
        }
      },
      "expect": {
        "id": 1,
        "result": {
          "protocol": 1
        }
      }
    },
    {
      "send": {
        "method": "resolve",
        "params": {
          "loc": "ref:notes",
          "sel": {
            "quote": "configurable",
            "prefix": "nothing like this",
            "suffix": "x",
            "pos": 999
          }
        }
      },
      "expect": {
        "id": 2,
        "result": {
          "units": [
            {
              "key": "n2",
              "kind": "note",
              "parent": "n1",
              "label": "The cap is configurable.",
              "fp": "<fingerprint>",
              "sel": {
                "key": "n2"
              },
              "text": "The cap is configurable."
            }
          ]
        }
      }
    }
  ],
  "end": "exit"
}
