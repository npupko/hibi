{
  "name": "resolve with the empty selector returns every unit of the resource",
  "fixture": "notes.json",
  "steps": [
    {
      "send": {
        "method": "hello",
        "params": {
          "protocol": [
            1
          ],
          "client": {
            "name": "conformance",
            "version": "0"
          },
          "root": "."
        }
      },
      "expect": {
        "id": 1,
        "result": {
          "protocol": 1
        }
      }
    },
    {
      "send": {
        "method": "resolve",
        "params": {
          "loc": "ref:notes",
          "sel": {}
        }
      },
      "expect": {
        "id": 2,
        "result": {
          "units": [
            {
              "key": "n1",
              "kind": "note",
              "parent": null,
              "label": "Retries are capped at 5.",
              "fp": "<fingerprint>",
              "sel": {
                "key": "n1"
              },
              "text": "Retries are capped at 5."
            },
            {
              "key": "n2",
              "kind": "note",
              "parent": "n1",
              "label": "The cap is configurable.",
              "fp": "<fingerprint>",
              "sel": {
                "key": "n2"
              },
              "text": "The cap is configurable."
            },
            {
              "key": "t1",
              "kind": "task",
              "parent": null,
              "label": "Document the retry cap.",
              "fp": "<fingerprint>",
              "sel": {
                "key": "t1"
              },
              "text": "Document the retry cap."
            }
          ]
        }
      }
    }
  ],
  "end": "exit"
}
