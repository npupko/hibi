{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{16}$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{16}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "code",
        "reference",
        "attested"
      ]
    },
    "sentence": {
      "type": "string",
      "minLength": 1
    },
    "doc": {
      "$ref": "#/$defs/SelectorBundle"
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/SelectorBundle"
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "procedure": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/Procedure"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "$ref": "#/$defs/Actor"
    },
    "ttl": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
    },
    "enforcement": {
      "default": "enforced",
      "type": "string",
      "enum": [
        "enforced",
        "suggested",
        "retired"
      ]
    },
    "attestations": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attestation"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "documentId",
    "kind",
    "sentence",
    "doc",
    "evidence",
    "sources",
    "procedure",
    "enforcement",
    "attestations",
    "createdAt",
    "ref"
  ],
  "additionalProperties": false,
  "$defs": {
    "SelectorBundle": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "selectors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Selector"
          }
        }
      },
      "required": [
        "file",
        "selectors"
      ],
      "additionalProperties": false
    },
    "Selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text-quote"
            },
            "exact": {
              "type": "string"
            },
            "prefix": {
              "default": "",
              "type": "string"
            },
            "suffix": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "exact",
            "prefix",
            "suffix"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text-position"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ast-node"
            },
            "language": {
              "type": "string"
            },
            "nodeType": {
              "type": "string"
            },
            "structuralHash": {
              "type": "string"
            },
            "semanticHash": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "language",
            "nodeType",
            "structuralHash",
            "semanticHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "language": {
              "type": "string"
            },
            "nodeKind": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "language",
            "nodeKind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "coarse"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "pattern"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "resource"
      ],
      "additionalProperties": false
    },
    "Procedure": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "stdin": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "command"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "instructions"
      ],
      "additionalProperties": false
    },
    "Actor": {
      "type": "string",
      "pattern": "^(human|agent|process):.+$"
    },
    "Attestation": {
      "type": "object",
      "properties": {
        "by": {
          "$ref": "#/$defs/Actor"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "basis": {
          "type": "string",
          "enum": [
            "vouch",
            "evidence",
            "ack"
          ]
        },
        "note": {
          "type": "string"
        },
        "evidenceHash": {
          "type": "string"
        },
        "ack": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pairId": {
                  "type": "string",
                  "minLength": 1
                },
                "sentenceHashes": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "pairId",
                "sentenceHashes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "judgeKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "judgeKey"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "by",
        "at",
        "basis"
      ],
      "additionalProperties": false
    }
  }
}
