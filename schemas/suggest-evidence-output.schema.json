{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "The success envelope of section 15.1: `{\"ok\": true, \"command\": ...}`\nfollowed by the keys of the command's output (which include\n`warnings`).",
  "type": "object",
  "properties": {
    "candidates": {
      "description": "Ordered by `p` descending, then locator, start offset and key; cut\nto `--limit`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SuggestCandidate"
      }
    },
    "command": {
      "type": "string"
    },
    "considered": {
      "description": "The number of candidates ranked, before the cut.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "model": {
      "type": "string"
    },
    "noneFits": {
      "description": "True when no candidate has `p >= 0.7`.",
      "type": "boolean"
    },
    "ok": {
      "description": "Always `true`.",
      "type": "boolean"
    },
    "statement": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "required": [
    "ok",
    "command",
    "model",
    "statement",
    "considered",
    "noneFits",
    "candidates",
    "warnings"
  ],
  "$defs": {
    "Anchor": {
      "description": "An anchor: a locator plus a selector (section 5.3).",
      "type": "object",
      "properties": {
        "loc": {
          "$ref": "#/$defs/Locator"
        },
        "sel": {
          "$ref": "#/$defs/Selector"
        }
      },
      "additionalProperties": false,
      "required": [
        "loc",
        "sel"
      ]
    },
    "Locator": {
      "description": "file:<path>, repo:<alias>//<path>, or <scheme>:<opaque> (spec section 5.1)",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[^\\u0000-\\u001f\\u007f]+$"
    },
    "Selector": {
      "description": "A selector (spec section 5.2). No key may be null.",
      "type": "object",
      "properties": {
        "key": {
          "description": "A unit key, for providers that address units by key.",
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "description": "Byte offset of the quote when it was recorded. A hint only.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "prefix": {
          "description": "Up to 48 characters that preceded the quote.",
          "type": "string"
        },
        "quote": {
          "description": "Text that occurs in the unit.",
          "type": "string",
          "minLength": 1
        },
        "suffix": {
          "description": "Up to 48 characters that followed the quote.",
          "type": "string"
        },
        "symbol": {
          "description": "Declaration path in a code resource.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "SuggestCandidate": {
      "description": "One entry of `candidates` in the output of `suggest-evidence`. A\nsuggestion to read, never a finding.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "The unit's locator with its completed selector.",
          "$ref": "#/$defs/Anchor"
        },
        "fits": {
          "description": "`p >= 0.7`.",
          "type": "boolean"
        },
        "loc": {
          "$ref": "#/$defs/Locator"
        },
        "p": {
          "description": "The Noul probability that reading this unit settles the statement.",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "$ref": "#/$defs/UnitRef"
        }
      },
      "required": [
        "loc",
        "unit",
        "anchor",
        "p",
        "fits"
      ]
    },
    "UnitRef": {
      "description": "UnitRef of section 15.2. `label` is `null` when the provider gave none;\n`line` and `endLine` are `null` without a range.",
      "type": "object",
      "properties": {
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "label",
        "line",
        "endLine"
      ]
    },
    "Warning": {
      "description": "One entry of `warnings` in the JSON envelope (section 15.1).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "WarningCode": {
      "description": "The closed warning-code list of section 15.1.",
      "type": "string",
      "enum": [
        "orphan_record",
        "unknown_replacement",
        "cache_unavailable",
        "git_too_old"
      ]
    }
  }
}
