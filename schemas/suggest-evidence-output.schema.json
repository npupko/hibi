{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hibi suggest-evidence output",
  "description": "The success envelope of section 15.1: `{\"ok\": true, \"command\": ...}`\nfollowed by the keys of the command's output (which include\n`warnings`).",
  "type": "object",
  "properties": {
    "candidates": {
      "description": "Ordered by `p` descending, then locator, start offset and key; cut\nto `--limit`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SuggestCandidate"
      }
    },
    "command": {
      "type": "string"
    },
    "considered": {
      "description": "The number of candidates ranked, before the cut.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "model": {
      "type": "string"
    },
    "noneFits": {
      "description": "True when no candidate has `p >= 0.7`.",
      "type": "boolean"
    },
    "ok": {
      "description": "Always `true`.",
      "type": "boolean",
      "const": true
    },
    "statement": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "ok",
    "command",
    "model",
    "statement",
    "considered",
    "noneFits",
    "candidates",
    "warnings"
  ],
  "$defs": {
    "Anchor": {
      "description": "An anchor: a locator plus a selector (section 5.3).",
      "type": "object",
      "properties": {
        "loc": {
          "$ref": "#/$defs/Locator"
        },
        "sel": {
          "$ref": "#/$defs/Selector"
        }
      },
      "additionalProperties": false,
      "required": [
        "loc",
        "sel"
      ]
    },
    "Locator": {
      "description": "file:<path>, repo:<alias>//<path>, or <scheme>:<opaque> (spec section 5.1)",
      "type": "string",
      "pattern": "^(?:file:(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+)*|repo:[a-z0-9][a-z0-9-]*//(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+)*|(?!file:|repo:)[a-z][a-z0-9-]*:[^\\u0000-\\u001f\\u007f]+)$"
    },
    "Selector": {
      "description": "A selector (spec section 5.2). No key may be null.",
      "type": "object",
      "properties": {
        "count": {
          "description": "With `symbol`: how many declarations the symbol named when the\nanchor was made. Without `symbol`, with `within`: how many\ncontainers `within` named then. Stored only when that was two or\nmore.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 2
        },
        "key": {
          "description": "A unit key, for providers that address units by key.",
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "description": "Up to 48 characters of the unit's own text before the quote.",
          "type": "string",
          "maxLength": 48
        },
        "quote": {
          "description": "Text that occurs in the unit. At most 2,048 characters, and not\nonly whitespace.",
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "suffix": {
          "description": "Up to 48 characters of the unit's own text after the quote.",
          "type": "string",
          "maxLength": 48
        },
        "symbol": {
          "description": "Declaration path in a code resource, as typed.",
          "type": "string",
          "minLength": 1
        },
        "within": {
          "description": "The container of the unit when the anchor was made: a heading path\nand piece name, or a declaration's symbol. Added by hibi.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "prefix": [
          "quote"
        ],
        "suffix": [
          "quote"
        ],
        "within": [
          "quote"
        ]
      },
      "dependentSchemas": {
        "count": {
          "anyOf": [
            {
              "required": [
                "symbol"
              ]
            },
            {
              "required": [
                "within"
              ]
            }
          ]
        }
      }
    },
    "SuggestCandidate": {
      "description": "One entry of `candidates` in the output of `suggest-evidence`. A\nsuggestion to read, never a finding.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "The unit's locator with its printed selector, to give to `claim`.\n`null` when no anchor selects this unit alone (it is identical to\nanother unit where it stands).",
          "anyOf": [
            {
              "$ref": "#/$defs/Anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "fits": {
          "description": "`p >= 0.7`.",
          "type": "boolean"
        },
        "loc": {
          "$ref": "#/$defs/Locator"
        },
        "p": {
          "description": "The Noul probability that reading this unit settles the statement.",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "$ref": "#/$defs/UnitRef"
        }
      },
      "required": [
        "loc",
        "unit",
        "anchor",
        "p",
        "fits"
      ]
    },
    "UnitRef": {
      "description": "UnitRef of section 15.2. `label` is `null` when the provider gave none;\n`line` and `endLine` are `null` without a range.",
      "type": "object",
      "properties": {
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "label",
        "line",
        "endLine"
      ]
    },
    "Warning": {
      "description": "One entry of `warnings` in the JSON envelope (section 15.1).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "WarningCode": {
      "description": "The closed warning-code list of section 15.1.",
      "type": "string",
      "enum": [
        "orphan_record",
        "unknown_replacement",
        "cache_unavailable",
        "git_too_old",
        "unknown_kind"
      ]
    }
  }
}
