{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hibi user config",
  "type": "object",
  "properties": {
    "providers": {
      "description": "One table per external scheme.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RawProvider"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "file",
            "repo"
          ]
        },
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "repo": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RawRepoEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RawProvider": {
      "type": "object",
      "properties": {
        "command": {
          "description": "argv: the program, then its arguments.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "timeout_ms": {
          "description": "Default 10000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 600000,
          "minimum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "RawRepoEntry": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "description": "Absolute: the directory to use.",
          "type": "string"
        },
        "root": {
          "description": "Absolute: the repository whose `hibi.toml` declares the alias.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "root",
        "alias",
        "path"
      ]
    }
  }
}
