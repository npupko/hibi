{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mark",
  "description": "A mark (section 3.3). Append-only.",
  "type": "object",
  "properties": {
    "at": {
      "description": "When the check happened.",
      "$ref": "#/$defs/Timestamp"
    },
    "by": {
      "description": "Free text, kept for audit, never interpreted.",
      "type": [
        "string",
        "null"
      ]
    },
    "claim": {
      "description": "Full id of the claim.",
      "$ref": "#/$defs/ClaimId"
    },
    "id": {
      "$ref": "#/$defs/MarkId"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "sides": {
      "description": "One entry per side, index-aligned with the claim's sides.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarkSide"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "claim",
    "at",
    "by",
    "sides",
    "note"
  ],
  "$defs": {
    "ClaimId": {
      "type": "string",
      "pattern": "^c1-[0-9a-hjkmnp-tv-z]{20}$"
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^b3:[a-z][a-z0-9-]*:[0-9a-f]{32,64}$"
    },
    "Locator": {
      "description": "file:<path>, repo:<alias>//<path>, or <scheme>:<opaque> (spec section 5.1)",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[^\\u0000-\\u001f\\u007f]+$"
    },
    "MarkId": {
      "type": "string",
      "pattern": "^m1-[0-9a-hjkmnp-tv-z]{20}$"
    },
    "MarkSide": {
      "description": "One side of a mark: the side's locator and its fingerprint at check time.",
      "type": "object",
      "properties": {
        "fp": {
          "$ref": "#/$defs/Fingerprint"
        },
        "loc": {
          "$ref": "#/$defs/Locator"
        }
      },
      "additionalProperties": false,
      "required": [
        "loc",
        "fp"
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 in UTC with second precision and the Z suffix",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
