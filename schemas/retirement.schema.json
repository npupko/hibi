{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retirement",
  "description": "A retirement (section 3.4). Permanent.",
  "type": "object",
  "properties": {
    "at": {
      "$ref": "#/$defs/Timestamp"
    },
    "by": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "$ref": "#/$defs/RetirementId"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "replacedBy": {
      "description": "Full id of another claim.",
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimId"
        },
        {
          "type": "null"
        }
      ]
    },
    "retires": {
      "description": "Full id of the retired claim.",
      "$ref": "#/$defs/ClaimId"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "retires",
    "replacedBy",
    "at",
    "by",
    "note"
  ],
  "$defs": {
    "ClaimId": {
      "type": "string",
      "pattern": "^c1-[0-9a-hjkmnp-tv-z]{20}$"
    },
    "RetirementId": {
      "type": "string",
      "pattern": "^r1-[0-9a-hjkmnp-tv-z]{20}$"
    },
    "Timestamp": {
      "description": "RFC 3339 in UTC with second precision and the Z suffix",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
