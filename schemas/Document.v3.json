{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "lifecycle": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "archived"
      ]
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "supersedes"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "path",
    "lifecycle",
    "edges"
  ],
  "additionalProperties": false
}
