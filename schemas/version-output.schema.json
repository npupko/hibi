{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "The success envelope of section 15.1: `{\"ok\": true, \"command\": ...}`\nfollowed by the keys of the command's output (which include\n`warnings`).",
  "type": "object",
  "properties": {
    "command": {
      "type": "string"
    },
    "grammars": {
      "description": "Resource class to the version of its grammar crate.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "judgeModel": {
      "description": "The model id sent to the judge service.",
      "type": "string"
    },
    "ok": {
      "description": "Always `true`.",
      "type": "boolean"
    },
    "profiles": {
      "description": "The fingerprint profiles.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocol": {
      "description": "The provider protocol versions this build speaks.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "storeVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "version": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "required": [
    "ok",
    "command",
    "version",
    "protocol",
    "storeVersion",
    "profiles",
    "grammars",
    "judgeModel",
    "warnings"
  ],
  "$defs": {
    "Warning": {
      "description": "One entry of `warnings` in the JSON envelope (section 15.1).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "WarningCode": {
      "description": "The closed warning-code list of section 15.1.",
      "type": "string",
      "enum": [
        "orphan_record",
        "unknown_replacement",
        "cache_unavailable",
        "git_too_old"
      ]
    }
  }
}
