{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hibi status output",
  "description": "The success envelope of section 15.1: `{\"ok\": true, \"command\": ...}`\nfollowed by the keys of the command's output (which include\n`warnings`).",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClaimView"
      }
    },
    "command": {
      "type": "string"
    },
    "nextNote": {
      "type": "string"
    },
    "now": {
      "$ref": "#/$defs/Timestamp"
    },
    "ok": {
      "description": "Always `true`.",
      "type": "boolean",
      "const": true
    },
    "since": {
      "anyOf": [
        {
          "$ref": "#/$defs/SinceView"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot": {
      "description": "`Store::snapshot_id`.",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/StatusSummary"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "ok",
    "command",
    "now",
    "snapshot",
    "since",
    "summary",
    "claims",
    "nextNote",
    "warnings"
  ],
  "$defs": {
    "Anchor": {
      "description": "An anchor: a locator plus a selector (section 5.3).",
      "type": "object",
      "properties": {
        "loc": {
          "$ref": "#/$defs/Locator"
        },
        "sel": {
          "$ref": "#/$defs/Selector"
        }
      },
      "additionalProperties": false,
      "required": [
        "loc",
        "sel"
      ]
    },
    "Candidate": {
      "description": "One unit a side's anchor could mean (section 15.2).",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "An anchor that selects this unit and no other unit of the resource,\nto give to `reanchor`: `<loc>#<symbol>`, or a JSON anchor.",
          "type": "string"
        },
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "sameFingerprint": {
          "description": "True when the unit's fingerprint equals the side's fingerprint in\nthe reference mark: the unit is the one that was marked, and it\nmoved or was renamed. `false` also when the claim has no mark.",
          "type": "boolean"
        },
        "text": {
          "description": "The unit text cut to 240 characters, or `null` when the provider\ngave none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "label",
        "line",
        "endLine",
        "text",
        "anchor",
        "sameFingerprint"
      ]
    },
    "ClaimId": {
      "type": "string",
      "pattern": "^c1-[0-9a-hjkmnp-tv-z]{20}$"
    },
    "ClaimState": {
      "description": "The state of a claim (section 9.3).",
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "expired",
        "retired"
      ]
    },
    "ClaimView": {
      "description": "ClaimView of section 15.2.",
      "type": "object",
      "properties": {
        "expiresAt": {
          "description": "`add(markedAt, recheck)` when the claim is `fresh` or `expired` and\n`recheck` is set.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/ClaimId"
        },
        "mark": {
          "description": "Id of the reference mark (section 9.3).",
          "anyOf": [
            {
              "$ref": "#/$defs/MarkId"
            },
            {
              "type": "null"
            }
          ]
        },
        "markedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "description": "One command line, or `null` (section 15.2).",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "recheck": {
          "type": [
            "string",
            "null"
          ]
        },
        "sides": {
          "description": "Empty for a retired claim.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Side"
          }
        },
        "state": {
          "$ref": "#/$defs/ClaimState"
        },
        "statement": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "recheck",
        "note",
        "state",
        "mark",
        "markedAt",
        "expiresAt",
        "sides",
        "next"
      ]
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^b3:[a-z][a-z0-9-]*:[0-9a-f]{32,64}$"
    },
    "Locator": {
      "description": "file:<path>, repo:<alias>//<path>, or <scheme>:<opaque> (spec section 5.1)",
      "type": "string",
      "pattern": "^(?:file:(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+)*|repo:[a-z0-9][a-z0-9-]*//(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+)*|(?!file:|repo:)[a-z][a-z0-9-]*:[^\\u0000-\\u001f\\u007f]+)$"
    },
    "MarkId": {
      "type": "string",
      "pattern": "^m1-[0-9a-hjkmnp-tv-z]{20}$"
    },
    "Reason": {
      "description": "Why a side is not `same` (section 9.2). A closed list.",
      "type": "string",
      "enum": [
        "scheme_not_declared",
        "provider_not_registered",
        "provider_failed",
        "resource_not_found",
        "not_text",
        "too_large",
        "repo_not_found",
        "repo_not_allowed",
        "provider_error",
        "resource_unavailable",
        "selector_not_found",
        "not_exact",
        "several_units",
        "no_mark",
        "fingerprint_differs",
        "profile_mismatch"
      ]
    },
    "Role": {
      "description": "`subject` for side 0, `evidence` for the others.",
      "type": "string",
      "enum": [
        "subject",
        "evidence"
      ]
    },
    "Selector": {
      "description": "A selector (spec section 5.2). No key may be null.",
      "type": "object",
      "properties": {
        "key": {
          "description": "A unit key, for providers that address units by key.",
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "description": "Byte offset of the quote when it was recorded. A hint only.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "prefix": {
          "description": "Up to 48 characters that preceded the quote.",
          "type": "string",
          "maxLength": 48
        },
        "quote": {
          "description": "Text that occurs in the unit. At most 2,048 characters, and not\nonly whitespace.",
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "suffix": {
          "description": "Up to 48 characters that followed the quote.",
          "type": "string",
          "maxLength": 48
        },
        "symbol": {
          "description": "Declaration path in a code resource.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "pos": [
          "quote"
        ],
        "prefix": [
          "quote"
        ],
        "suffix": [
          "quote"
        ]
      }
    },
    "Side": {
      "description": "Side of section 15.2.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "The anchor as stored.",
          "$ref": "#/$defs/Anchor"
        },
        "candidates": {
          "description": "Present when the side is `ambiguous`, or `missing` with reason\n`not_exact`: the units the stored anchor could mean, at most\n[`MAX_CANDIDATES`](super::MAX_CANDIDATES). A candidate is a guess to\ncheck, never the side's unit.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Candidate"
          }
        },
        "candidatesTotal": {
          "description": "Present with `candidates`: how many there are in all.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "detail": {
          "description": "For a side that cannot be evaluated: what the provider or the\nregistry said, cut to [`DETAIL_CHARS`] characters. `null` otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "fp": {
          "description": "The current fingerprint.",
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "index": {
          "description": "0 for the subject.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "markedFp": {
          "description": "The fingerprint in the reference mark.",
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "remediation": {
          "description": "For a side that cannot be evaluated: what the limit or the cause is\nand what the author can do ([`unavailable_remediation`]). For\n`resource_unavailable` it is the provider's own message and what to\ndo after it. `null` for every other side; a side that changed, is\nmissing or is ambiguous is answered by the claim's `next`.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "state": {
          "$ref": "#/$defs/SideState"
        },
        "text": {
          "description": "The current unit text. Present only with `--detail`.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "The unit the side resolves to exactly, or `null`.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnitRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "index",
        "role",
        "anchor",
        "state",
        "reason",
        "unit",
        "fp",
        "markedFp",
        "remediation",
        "detail"
      ]
    },
    "SideState": {
      "description": "The state of one side (section 9.2).",
      "type": "string",
      "enum": [
        "same",
        "changed",
        "missing",
        "ambiguous",
        "unavailable"
      ]
    },
    "SinceView": {
      "description": "`since` in the output of `status` and `cover`.",
      "type": "object",
      "properties": {
        "base": {
          "description": "The base commit id.",
          "type": "string"
        },
        "range": {
          "type": "string"
        }
      },
      "required": [
        "range",
        "base"
      ]
    },
    "StatusSummary": {
      "description": "`summary` in the output of `status`: every claim in the store.\n`claims` is the sum of `fresh`, `stale`, `expired` and `retired`.",
      "type": "object",
      "properties": {
        "claims": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "fresh": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "claims",
        "fresh",
        "stale",
        "expired",
        "retired"
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 in UTC with second precision and the Z suffix",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "UnitRef": {
      "description": "UnitRef of section 15.2. `label` is `null` when the provider gave none;\n`line` and `endLine` are `null` without a range.",
      "type": "object",
      "properties": {
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "label",
        "line",
        "endLine"
      ]
    },
    "Warning": {
      "description": "One entry of `warnings` in the JSON envelope (section 15.1).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "WarningCode": {
      "description": "The closed warning-code list of section 15.1.",
      "type": "string",
      "enum": [
        "orphan_record",
        "unknown_replacement",
        "cache_unavailable",
        "git_too_old",
        "unknown_kind"
      ]
    }
  }
}
